<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#050914">
  <meta name="description" content="Un girasol antes del amanecer. Una pequeña historia interactiva para Andrea.">
  <title>Un girasol antes del amanecer</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
  <script src="js/app.js" defer></script>
</head>
<body>
  <noscript>
    <div class="noscript-message">Esta pequeña historia necesita JavaScript para poder abrir sus estrellas.</div>
  </noscript>

  <div class="experience" id="experience" data-time-of-day="night">
    <div class="ambient" aria-hidden="true">
      <div class="ambient__wash"></div>
      <div class="ambient__swirl ambient__swirl--one"></div>
      <div class="ambient__swirl ambient__swirl--two"></div>
      <div class="ambient__stars" id="ambient-stars"></div>
      <div class="ambient__grain"></div>
    </div>

    <div class="progress-track" aria-hidden="true">
      <div class="progress-track__fill" id="story-progress"></div>
    </div>

    <button class="audio-control" id="audio-control" type="button" aria-label="Activar música" aria-pressed="false">
      <span class="audio-control__icon" aria-hidden="true">♪</span>
      <span class="sr-only audio-control__label">Activar música</span>
    </button>
    <audio id="background-music" loop preload="none">
      <source src="assets/audio/background-music.mp3" type="audio/mpeg">
    </audio>

    <main class="scenes" id="scenes">
      <section class="scene scene--intro is-active" id="scene-intro" data-scene="intro" aria-hidden="false">
        <div class="scene__art intro-art" aria-hidden="true">
          <span class="paint-arc paint-arc--one"></span>
          <span class="paint-arc paint-arc--two"></span>
        </div>
        <div class="scene__content scene__content--center intro-content">
          <button class="story-star intro-star" id="intro-star" type="button" aria-label="Tocar la estrella" disabled>
            <span class="story-star__core" aria-hidden="true">✦</span>
            <span class="story-star__ring" aria-hidden="true"></span>
            <span class="story-star__stroke story-star__stroke--one" aria-hidden="true"></span>
            <span class="story-star__stroke story-star__stroke--two" aria-hidden="true"></span>
            <span class="story-star__stroke story-star__stroke--three" aria-hidden="true"></span>
          </button>

          <div class="intro-copy intro-copy--before" id="intro-before">
            <p class="eyebrow reveal-copy" data-enter-delay="1500">ANDREA</p>
            <h1 class="scene-title scene-title--quiet reveal-copy" data-enter-delay="3500">Creo que este año tenemos<br>un pequeño problema…</h1>
            <p class="interaction-hint reveal-copy" data-enter-delay="6000" data-enable-target="intro-star">Toca la estrella</p>
          </div>

          <div class="intro-copy intro-copy--after" id="intro-after" aria-live="polite">
            <p class="story-line">El 21 no voy a estar contigo.</p>
            <p class="story-line">No me gustaba mucho la idea de dejar que una fecha decidiera cuándo podía darte algo bonito.</p>
            <p class="story-line">Así que hice algo…</p>
            <button class="text-button next-button" id="begin-night" type="button" disabled>Comenzar la noche <span aria-hidden="true">✦</span></button>
          </div>
        </div>
      </section>

      <section class="scene scene--night" id="scene-night" data-scene="night" aria-hidden="true" inert>
        <div class="scene__art night-sky" aria-hidden="true">
          <span class="oil-star oil-star--1"></span>
          <span class="oil-star oil-star--2"></span>
          <span class="oil-star oil-star--3"></span>
          <span class="oil-star oil-star--4"></span>
          <div class="night-sky__new-stars" id="night-new-stars"></div>
        </div>
        <div class="scene__content scene__content--center night-content">
          <div class="story-copy story-copy--narrow">
            <h2 class="scene-title reveal-copy" data-enter-delay="400">Todo empieza de noche.</h2>
            <p class="story-line reveal-copy" data-enter-delay="2700">Cuando todavía no sabemos exactamente cómo va a verse el amanecer…</p>
            <p class="story-line reveal-copy" data-enter-delay="5700">pero aun así decidimos quedarnos un poquito más.</p>
            <p class="interaction-hint reveal-copy" data-enter-delay="8300" data-enable-target="special-star">Hay una que está brillando distinto.</p>
          </div>
          <button class="story-star special-star" id="special-star" type="button" aria-label="Tocar la estrella que brilla distinto" disabled>
            <span class="story-star__core" aria-hidden="true">✦</span>
            <span class="story-star__ring" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section class="scene scene--constellation" id="scene-constellation" data-scene="constellation" aria-hidden="true" inert>
        <div class="scene__content scene__content--wide constellation-content">
          <p class="story-line constellation-intro reveal-copy" data-enter-delay="350">A veces los momentos bonitos empiezan siendo cosas muy pequeñas.</p>

          <div class="constellation" id="constellation" aria-label="Cinco estrellas por encender">
            <svg class="constellation__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <path d="M16 30 L38 64 L55 27 L72 66 L87 37" pathLength="1"></path>
            </svg>
            <button class="constellation-star" style="--x:16%;--y:30%;--i:0" type="button" data-word="una conversación" aria-label="Encender la primera estrella"><span aria-hidden="true">✦</span><small>una conversación</small></button>
            <button class="constellation-star" style="--x:38%;--y:64%;--i:1" type="button" data-word="una risa" aria-label="Encender la segunda estrella"><span aria-hidden="true">✦</span><small>una risa</small></button>
            <button class="constellation-star" style="--x:55%;--y:27%;--i:2" type="button" data-word="un detalle" aria-label="Encender la tercera estrella"><span aria-hidden="true">✦</span><small>un detalle</small></button>
            <button class="constellation-star" style="--x:72%;--y:66%;--i:3" type="button" data-word="una mirada" aria-label="Encender la cuarta estrella"><span aria-hidden="true">✦</span><small>una mirada</small></button>
            <button class="constellation-star" style="--x:87%;--y:37%;--i:4" type="button" data-word="un momento inesperado" aria-label="Encender la quinta estrella"><span aria-hidden="true">✦</span><small>un momento inesperado</small></button>
            <button class="easter-star" id="easter-star" type="button" aria-label="Una estrella diminuta"><span aria-hidden="true">·</span></button>
          </div>

          <div class="constellation-result" id="constellation-result" aria-live="polite">
            <p>Y sin darnos cuenta…</p>
            <p class="special-line">algo empieza a tomar forma.</p>
          </div>
          <button class="text-button next-button" id="constellation-next" type="button" disabled>Seguir la constelación</button>
        </div>
        <div class="easter-message" id="easter-message" role="status">P.D. Sí, probablemente me emocioné haciendo esto 😂</div>
      </section>

      <section class="scene scene--reveal" id="scene-reveal" data-scene="reveal" aria-hidden="true" inert>
        <div class="scene__content reveal-content">
          <p class="story-line story-line--top reveal-copy" data-enter-delay="300">Hay cosas que solo se ven cuando uno se toma el tiempo de mirar bien.</p>
          <div class="reveal-frame" id="reveal-frame">
            <div class="reveal-painting" aria-hidden="true">
              <img class="optional-art" data-optional-image="foto1" alt="">
              <span class="reveal-painting__sky"></span>
              <span class="reveal-painting__hill reveal-painting__hill--back"></span>
              <span class="reveal-painting__hill reveal-painting__hill--front"></span>
              <span class="reveal-painting__light"></span>
              <span class="reveal-painting__flower reveal-painting__flower--one"></span>
              <span class="reveal-painting__flower reveal-painting__flower--two"></span>
            </div>
            <canvas class="fog-canvas" id="fog-canvas" aria-label="Cristal empañado. Arrastra el dedo para descubrir la imagen."></canvas>
            <div class="reveal-meter" aria-hidden="true"><span id="reveal-meter-fill"></span></div>
          </div>
          <p class="interaction-hint reveal-copy" data-enter-delay="2500">Desliza sobre la niebla</p>
          <button class="hold-button hold-button--reveal" id="reveal-hold" type="button" aria-label="Mantener presionado para revelar la imagen">
            <span class="hold-button__ring" aria-hidden="true"></span>
            <span>Mantén para revelar</span>
          </button>
          <div class="reveal-result" id="reveal-result" aria-live="polite">
            <p>Y últimamente…</p>
            <p class="special-line">me gusta mucho lo que estoy descubriendo de ti.</p>
          </div>
          <button class="text-button next-button" id="reveal-next" type="button" disabled>Mirar un poco más</button>
        </div>
      </section>

      <section class="scene scene--painting" id="scene-painting" data-scene="painting" aria-hidden="true" inert>
        <div class="scene__content painting-content">
          <div class="painting-copy">
            <p class="story-line reveal-copy" data-enter-delay="250">No creo que las historias bonitas aparezcan terminadas.</p>
            <p class="special-line reveal-copy" data-enter-delay="2400">Se van pintando.</p>
            <p class="brush-words reveal-copy" data-enter-delay="4300"><span>Un detalle.</span><span>Un momento.</span><span>Una conversación a la vez.</span></p>
          </div>

          <div class="unfinished-painting" id="unfinished-painting" aria-label="Un paisaje por terminar">
            <img class="optional-art" data-optional-image="foto2" alt="">
            <span class="painting-layer painting-layer--sky" data-piece-layer="sky"></span>
            <span class="painting-layer painting-layer--ridge" data-piece-layer="ridge"></span>
            <span class="painting-layer painting-layer--path" data-piece-layer="path"></span>
            <span class="painting-layer painting-layer--home" data-piece-layer="home"><i></i></span>
            <button class="paint-point" style="--x:25%;--y:28%;--i:0" type="button" data-paint-piece="sky" aria-label="Añadir una pincelada al cielo"><span aria-hidden="true">1</span></button>
            <button class="paint-point" style="--x:72%;--y:43%;--i:1" type="button" data-paint-piece="ridge" aria-label="Añadir una pincelada a la montaña"><span aria-hidden="true">2</span></button>
            <button class="paint-point" style="--x:43%;--y:73%;--i:2" type="button" data-paint-piece="path" aria-label="Añadir una pincelada al sendero"><span aria-hidden="true">3</span></button>
            <button class="paint-point" style="--x:78%;--y:68%;--i:3" type="button" data-paint-piece="home" aria-label="Añadir una pincelada de luz"><span aria-hidden="true">4</span></button>
            <span class="paint-spark" id="paint-spark" aria-hidden="true"></span>
          </div>
          <p class="interaction-hint reveal-copy" data-enter-delay="6600">Toca los cuatro puntos del lienzo</p>
          <div class="painting-result" id="painting-result" aria-live="polite">
            <p>No sé exactamente cómo terminará nuestro cuadro…</p>
            <p class="special-line">pero me gusta seguir pintándolo contigo.</p>
          </div>
          <button class="text-button next-button" id="painting-next" type="button" disabled>Dejar secar la pintura</button>
        </div>
      </section>

      <section class="scene scene--sunflower" id="scene-sunflower" data-scene="sunflower" aria-hidden="true" inert>
        <div class="scene__content sunflower-content">
          <p class="story-line sunflower-intro reveal-copy" data-enter-delay="300">Y en medio de todo esto hay cosas tuyas que me gustan más de lo que probablemente te digo.</p>
          <div class="sunflower-bloom" id="sunflower-bloom">
            <div class="sunflower-bloom__stem" aria-hidden="true"></div>
            <div class="sunflower-bloom__leaf" aria-hidden="true"></div>
            <div class="sunflower-bloom__head">
              <div class="petals" aria-hidden="true">
                <i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i><i style="--i:3"></i>
                <i style="--i:4"></i><i style="--i:5"></i><i style="--i:6"></i><i style="--i:7"></i>
                <i style="--i:8"></i><i style="--i:9"></i><i style="--i:10"></i><i style="--i:11"></i>
              </div>
              <button class="sunflower-center" id="sunflower-center" type="button" aria-label="Tocar el centro para abrir el girasol"><span aria-hidden="true"></span></button>
            </div>
            <div class="petal-thoughts" aria-live="polite">
              <span style="--i:0">Tu forma de ser</span>
              <span style="--i:1">Tu manera de sonreír</span>
              <span style="--i:2">Tu carácter</span>
              <span style="--i:3">Tus ocurrencias</span>
              <span style="--i:4">Tu forma de hacer especiales ciertos momentos</span>
            </div>
          </div>
          <p class="interaction-hint reveal-copy" data-enter-delay="2900">Toca el centro</p>
          <div class="sunflower-result" id="sunflower-result" aria-live="polite">
            <p>No necesitas ser perfecta para ser especial.</p>
            <p class="special-line">Me basta con que seas tú.</p>
          </div>
          <button class="text-button next-button" id="sunflower-next" type="button" disabled>Quedarnos un momento</button>
        </div>
      </section>

      <section class="scene scene--pause" id="scene-pause" data-scene="pause" aria-hidden="true" inert>
        <div class="scene__art pause-sky" aria-hidden="true"><span class="breathing-light"></span></div>
        <div class="scene__content scene__content--center pause-content">
          <div class="pause-copy" id="pause-copy">
            <p class="scene-title scene-title--small reveal-copy" data-enter-delay="300">Antes de seguir…</p>
            <p class="story-line reveal-copy" data-enter-delay="3000">solo quería dejarte aquí un momento.</p>
            <p class="story-line reveal-copy" data-enter-delay="5500">No tienes que hacer nada.</p>
            <p class="special-line reveal-copy" data-enter-delay="7000">Solo quédate.</p>
          </div>
          <div class="memory" id="memory">
            <p>Hay recuerdos que no necesitan explicación.</p>
            <figure class="memory-photo">
              <!-- FOTO ESPECIAL ANDREA -->
              <div class="memory-photo__fallback" aria-hidden="true"><span></span><i></i></div>
              <img data-optional-image="special" alt="Un recuerdo especial de Andrea y Joseph">
              <figcaption>un momento para guardar</figcaption>
            </figure>
            <button class="text-button next-button" id="pause-next" type="button">Seguir cuando quieras</button>
          </div>
          <button class="pause-skip" id="pause-skip" type="button">Continuar sin esperar</button>
        </div>
      </section>

      <section class="scene scene--dawn" id="scene-dawn" data-scene="dawn" aria-hidden="true" inert>
        <div class="scene__art dawn-sky" aria-hidden="true">
          <span class="dawn-sky__night"></span>
          <span class="dawn-sky__violet"></span>
          <span class="dawn-sky__gold"></span>
          <span class="dawn-horizon"></span>
        </div>
        <div class="scene__content scene__content--center dawn-content">
          <div class="dawn-copy">
            <p class="scene-title scene-title--small reveal-copy" data-enter-delay="300">Y entonces…</p>
            <p class="story-line reveal-copy" data-enter-delay="2300">sin hacer demasiado ruido…</p>
            <p class="special-line reveal-copy" data-enter-delay="4400">empieza a cambiar el cielo.</p>
          </div>
          <div class="dawn-control">
            <button class="dawn-sun" id="dawn-sun" type="button" aria-label="Mantener presionado para hacer amanecer" disabled>
              <span class="dawn-sun__disc" aria-hidden="true"></span>
              <span class="dawn-sun__ring" aria-hidden="true"></span>
            </button>
            <p class="interaction-hint reveal-copy" data-enter-delay="6300" data-enable-target="dawn-sun">Mantén presionado el horizonte</p>
            <div class="dawn-meter" role="progressbar" aria-label="Progreso del amanecer" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
            <button class="quiet-button reveal-copy" data-enter-delay="7600" id="dawn-accessible" type="button">Dejar amanecer</button>
          </div>
          <div class="dawn-result" id="dawn-result" aria-live="polite">
            <p>Ya casi llega el amarillo.</p>
            <button class="text-button next-button" id="dawn-next" type="button" disabled>Seguir la luz</button>
          </div>
        </div>
      </section>

      <section class="scene scene--growth" id="scene-growth" data-scene="growth" aria-hidden="true" inert>
        <div class="scene__art growth-glow" aria-hidden="true"></div>
        <div class="scene__content scene__content--center growth-content">
          <p class="story-line growth-intro reveal-copy" data-enter-delay="300">Supongo que ahora entiendes por qué quería traerte hasta aquí.</p>
          <div class="growing-flower" id="growing-flower" aria-label="Un girasol creciendo">
            <span class="growing-flower__ground" aria-hidden="true"></span>
            <span class="growing-flower__stem" aria-hidden="true"></span>
            <span class="growing-flower__leaf growing-flower__leaf--left" aria-hidden="true"></span>
            <span class="growing-flower__leaf growing-flower__leaf--right" aria-hidden="true"></span>
            <span class="growing-flower__head" aria-hidden="true">
              <span class="growing-flower__petals"></span>
              <span class="growing-flower__center"></span>
            </span>
          </div>
          <div class="growth-copy">
            <p class="story-line reveal-copy" data-enter-delay="5200">El amarillo estaba desde el principio.</p>
            <p class="special-line reveal-copy" data-enter-delay="7600">Solo necesitaba tiempo para aparecer.</p>
          </div>
          <button class="text-button next-button reveal-copy" data-enter-delay="9800" data-enable-target="growth-next" id="growth-next" type="button" disabled>Caminar hacia las flores</button>
        </div>
      </section>

      <section class="scene scene--field" id="scene-field" data-scene="field" aria-hidden="true" inert>
        <div class="scene__art field-sky" aria-hidden="true"><span></span></div>
        <div class="flower-field" aria-hidden="true">
          <i class="field-flower" style="--x:6%;--s:.67;--d:.5s"></i>
          <i class="field-flower" style="--x:17%;--s:.85;--d:1.1s"></i>
          <i class="field-flower" style="--x:29%;--s:.7;--d:.2s"></i>
          <i class="field-flower" style="--x:40%;--s:1.05;--d:1.5s"></i>
          <i class="field-flower" style="--x:52%;--s:.78;--d:.8s"></i>
          <i class="field-flower" style="--x:63%;--s:1;--d:0s"></i>
          <i class="field-flower" style="--x:74%;--s:.66;--d:1.3s"></i>
          <i class="field-flower" style="--x:84%;--s:.9;--d:.4s"></i>
          <i class="field-flower" style="--x:94%;--s:.72;--d:1.8s"></i>
        </div>
        <div class="scene__content scene__content--center field-content">
          <div class="field-copy">
            <p class="story-line reveal-copy" data-enter-delay="400">El 21 es el Día de las Flores Amarillas.</p>
            <p class="story-line reveal-copy" data-enter-delay="3200">Pero este año las tuyas llegaron antes.</p>
            <p class="story-line reveal-copy" data-enter-delay="6100">Porque hay cosas bonitas…</p>
            <p class="field-revelation reveal-copy" data-enter-delay="8500">que no deberían esperar una fecha.</p>
          </div>
          <button class="text-button next-button reveal-copy" data-enter-delay="10800" data-enable-target="field-next" id="field-next" type="button" disabled>Hay algo más</button>
        </div>
      </section>

      <section class="scene scene--letter" id="scene-letter" data-scene="letter" aria-hidden="true" inert>
        <div class="scene__art letter-light" aria-hidden="true"></div>
        <div class="scene__content scene__content--center letter-content">
          <article class="letter-sheet" aria-labelledby="letter-heading">
            <div class="letter-sheet__grain" aria-hidden="true"></div>
            <h2 id="letter-heading">Andrea,</h2>
            <div class="letter-sheet__body" aria-live="polite" aria-atomic="true">
              <p id="letter-text"></p>
            </div>
            <div class="letter-sheet__mark" id="letter-mark" aria-hidden="true"></div>
            <p class="letter-sheet__signature" id="letter-signature">— Joseph</p>
          </article>
          <p class="letter-hint" id="letter-hint">Una línea a la vez.</p>
          <button class="text-button letter-button" id="letter-next-line" type="button">Seguir leyendo</button>
          <button class="text-button next-button" id="letter-finish" type="button" disabled>Guardar esta carta</button>
        </div>
      </section>

      <section class="scene scene--final" id="scene-final" data-scene="final" aria-hidden="true" inert>
        <div class="scene__art final-sky" aria-hidden="true">
          <span class="final-sun"></span>
          <div class="final-particles" id="final-particles"></div>
        </div>
        <div class="flower-field flower-field--final" aria-hidden="true">
          <i class="field-flower" style="--x:4%;--s:.8;--d:.1s"></i>
          <i class="field-flower" style="--x:14%;--s:1.05;--d:.8s"></i>
          <i class="field-flower" style="--x:26%;--s:.72;--d:1.4s"></i>
          <i class="field-flower" style="--x:37%;--s:.94;--d:.4s"></i>
          <i class="field-flower" style="--x:49%;--s:1.12;--d:1s"></i>
          <i class="field-flower" style="--x:61%;--s:.75;--d:.6s"></i>
          <i class="field-flower" style="--x:72%;--s:1;--d:1.6s"></i>
          <i class="field-flower" style="--x:84%;--s:.82;--d:.2s"></i>
          <i class="field-flower" style="--x:95%;--s:1.04;--d:1.1s"></i>
        </div>
        <div class="scene__content scene__content--center final-content">
          <p class="final-kicker reveal-copy" data-enter-delay="500">Un girasol antes del amanecer <span aria-hidden="true">🌻</span></p>
          <h2 class="final-title reveal-copy" data-enter-delay="3000">Para Andrea.</h2>
          <p class="final-line reveal-copy" data-enter-delay="5600">Gracias por seguir pintando conmigo.</p>
          <button class="text-button replay-button reveal-copy" data-enter-delay="8000" data-enable-target="replay-story" id="replay-story" type="button" disabled>Volver a mirar el cielo</button>
        </div>
      </section>
    </main>

    <div class="transition-veil" id="transition-veil" aria-hidden="true"><span></span><i></i></div>
    <div class="sr-only" id="scene-announcer" aria-live="polite" aria-atomic="true"></div>
  </div>
</body>
</html>
